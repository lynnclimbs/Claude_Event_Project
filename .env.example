# Copy to .env and fill in. Never commit .env — this repo is public.
# Vite only exposes vars prefixed with VITE_ to the browser.

# ── Server-side only (used by api/token.ts) ──────────────────────────────────
# Needs the `convai_write` permission to mint conversation tokens.
# A key scoped to text-to-speech only will 401 with `missing_permissions`.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# ── Client-side (bundled into the browser — public by definition) ────────────
# The agent id is not a secret; it identifies which agent to connect to.
VITE_ELEVENLABS_AGENT_ID=

# `private` (default) fetches a token from /api/token — requires `vercel dev`.
# `public`  connects straight from the browser with the agent id alone. No
#           server needed, but anyone with the id can talk on your credits.
#           Development only, and guard the agent with a domain allowlist.
VITE_CONNECTION_MODE=public
