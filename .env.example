# Copy to .env and fill in. Never commit .env — this repo is public.
# Vite only exposes vars prefixed with VITE_ to the browser.

# WARNING: any VITE_-prefixed value is bundled into the client and publicly
# visible. Do not put an Anthropic API key here — call the API from a server
# or proxy instead.
VITE_API_BASE_URL=http://localhost:8787
